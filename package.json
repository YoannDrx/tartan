{
  "name": "tartan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @tartan/web dev",
    "dev:mobile": "pnpm --filter @tartan/mobile start",
    "build": "pnpm --filter @tartan/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @tartan/web test:e2e",
    "design:check": "node scripts/design-check.mjs",
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:reset": "bash scripts/db-local.sh reset",
    "db:migrate": "pnpm --filter @tartan/web db:migrate",
    "db:seed": "pnpm --filter @tartan/web db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@expo-google-fonts/barlow-condensed": "0.4.1",
    "opentype.js": "1.3.4",
    "sharp": "0.35.5",
    "impeccable": "4.8.0"
  }
}
