# Base (local : pnpm db:start ; Neon Francfort en preview et production)
# Hors production, la base de production et une clé Stripe réelle sont refusées au démarrage.
DATABASE_URL=postgresql://tartan@localhost:54329/tartan
# Connexion directe pour les migrations. Vide : DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Better Auth : openssl rand -base64 32
BETTER_AUTH_SECRET=remplacer-par-un-secret-de-32-caracteres-minimum
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Connexions tierces (laisser vide tant que les comptes ne sont pas ouverts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=coach.tartan.app

# E-mails : sans clé, les e-mails sont écrits dans les journaux en local
RESEND_API_KEY=
EMAIL_FROM=Tartan <tartan@mail.tartan.coach>
EMAIL_CONTACT=hello@tartan.coach

# Ouverture : closed réserve la création d'espace coach aux adresses listées, public l'ouvre à tous
COACH_SIGNUP_MODE=public
COACH_SIGNUP_EMAILS=
# Accès à la console de l'éditeur (adresses séparées par des virgules)
ADMIN_EMAILS=
# Parcours d'accord parental : dormant en V1, réservée aux majeurs. Vide : désactivé.
PARENTAL_FLOW_ENABLED=

# Vidéo Mux : sans clé, l'envoi vidéo est désactivé proprement
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Offre gratuite de Mux : 10 vidéos stockées au plus. Vide : aucun plafond.
MUX_VIDEO_LIMIT=

# Paiement web : pnpm --filter @tartan/web exec tsx --env-file=.env scripts/stripe-setup.ts crée les prix
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH_MONTH=
STRIPE_PRICE_COACH_YEAR=
STRIPE_PRICE_CLUB_MONTH=
STRIPE_PRICE_CLUB_YEAR=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_TAX_ENABLED=false

# Achats intégrés iOS et Android
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_PRODUCT_COACH=tartan_coach_monthly,tartan_coach_yearly
REVENUECAT_PRODUCT_CLUB=tartan_club_monthly,tartan_club_yearly

# Fichiers
BLOB_READ_WRITE_TOKEN=

# Push navigateur : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@tartan.coach

# Liens Android : empreintes SHA-256 de Play App Signing, séparées par des virgules
ANDROID_SHA256_FINGERPRINTS=

# Jetons Expo (facultatif) et tâches planifiées
EXPO_ACCESS_TOKEN=
CRON_SECRET=remplacer-par-un-secret
# Signal de vie vers la sonde externe, une adresse par tâche. Vide : aucun appel.
CRON_HEARTBEAT_URL=
CRON_HEARTBEAT_NOTIFICATIONS_URL=

# SMS d'invitation : non configuré en V1 (le coach partage le lien)

# Suivi des erreurs. Vide : désactivé.
NEXT_PUBLIC_SENTRY_DSN=
