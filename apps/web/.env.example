# Tartan web : modèle des variables d'environnement
#
# Copie ce fichier en `apps/web/.env` pour le développement local, puis remplis ce dont tu as besoin
# (au minimum DATABASE_URL et BETTER_AUTH_SECRET).
# Une valeur vide ("") vaut une variable absente : le défaut du code s'applique (src/lib/env.ts).
# Aucun secret ici : le dépôt est public. Les vraies valeurs vivent sur Vercel, EAS et GitHub.
#
# Repères, pour chaque variable :
#   [requis]     sans elle, l'application ne démarre pas
#   [défaut X]   valeur prise par le code quand la variable est vide
#   Vercel : P = production, V = preview (relevé du 15 novembre 2026)
#
# Garde : hors production, la base de production et une clé Stripe réelle (sk_live_, rk_live_)
# sont refusées au démarrage (assertEnvIsolation). Ne pas la contourner.

# ─── 1. Base de données ──────────────────────────────────────────────────────────
# Local : `pnpm db:start` (Postgres sur le port 54329), puis `pnpm db:migrate` et `pnpm db:seed`.
# Adresse locale : postgresql://tartan@localhost:54329/tartan
DATABASE_URL=""                       # [requis] connexion poolée. Vercel : P, V (branche Neon `preview`)
DATABASE_URL_UNPOOLED=""              # connexion directe pour les migrations ; vide : DATABASE_URL. Vercel : P, V

# ─── 2. Authentification et adresses ─────────────────────────────────────────────
BETTER_AUTH_SECRET=""                 # [requis] 32 caractères minimum : `openssl rand -base64 32`. Vercel : P, V
BETTER_AUTH_URL=""                    # [défaut http://localhost:3000] ; en preview, l'adresse du déploiement. Vercel : P, V
NEXT_PUBLIC_APP_URL=""                # [défaut http://localhost:3000] ; même règle. Vercel : P, V
PASSKEY_RP_ID=""                      # domaine des passkeys ; vide : celui de BETTER_AUTH_URL. Vercel : P

# Connexion Google et Apple : comptes non ouverts en V1, laisser vide.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ─── 3. Ouverture et console d'administration ───────────────────────────────────
COACH_SIGNUP_MODE=""                  # [défaut closed] closed : espace coach réservé à la liste ; public : ouvert à tous. Vercel : P, V
COACH_SIGNUP_EMAILS=""                # adresses autorisées en mode closed, séparées par des virgules. Vercel : P, V
ADMIN_EMAILS=""                       # accès à la console, séparées par des virgules. Vercel : P
ADMIN_BOOTSTRAP_TOKEN=""              # enrôlement de la première passkey ; à retirer après la passkey de secours. Vercel : P
PARENTAL_FLOW_ENABLED=""              # parcours d'accord parental, dormant en V1 (majeurs seulement) ; "true" l'active

# ─── 4. E-mails (Resend) ─────────────────────────────────────────────────────────
# Sans clé, les e-mails sont écrits dans les journaux (local et preview).
RESEND_API_KEY=""                     # Vercel : P
RESEND_WEBHOOK_SECRET=""              # Vercel : P
RESEND_PREVIOUS_SENDERS=""            # anciennes adresses d'envoi exactes, pour les événements retardés. Vercel : P
EMAIL_FROM=""                         # [défaut Tartan <tartan@mail.tartan.coach>]. Vercel : P, V
EMAIL_CONTACT=""                      # [défaut hello@tartan.coach]. Vercel : P, V

# ─── 5. Vidéo (Mux) ──────────────────────────────────────────────────────────────
# Sans clé, l'envoi vidéo est désactivé proprement.
MUX_TOKEN_ID=""                       # Vercel : P, V
MUX_TOKEN_SECRET=""                   # Vercel : P, V
MUX_WEBHOOK_SECRET=""                 # Vercel : P, V
MUX_SIGNING_KEY_ID=""                 # lecture signée des vidéos. Vercel : P, V
MUX_SIGNING_PRIVATE_KEY=""            # Vercel : P, V
MUX_VIDEO_LIMIT=""                    # plafond technique global (offre gratuite de Mux : 10 vidéos) ; vide : aucun. Vercel : P

# ─── 6. Paiement web (Stripe) ───────────────────────────────────────────────────
# Configuration et recette : docs/plans/stripe.md. Hors production : clé de test uniquement.
STRIPE_SECRET_KEY=""                  # sk_test_ en local et en preview. Vercel : P (réelle), V (test)
STRIPE_WEBHOOK_SECRET=""              # Vercel : P, V
STRIPE_PRICE_COACH_MONTH=""           # Vercel : P, V
STRIPE_PRICE_COACH_YEAR=""            # Vercel : P, V
STRIPE_PRICE_CLUB_MONTH=""            # Vercel : P, V
STRIPE_PRICE_CLUB_YEAR=""             # Vercel : P, V
STRIPE_PORTAL_CONFIGURATION_ID=""     # portail client ; vide : configuration par défaut de Stripe. Vercel : P
BILLING_CHECKOUT_ENABLED=""           # [défaut true] "false" arrête les nouvelles souscriptions, pas les webhooks ni le portail
STRIPE_TAX_ENABLED=""                 # [défaut false] micro-entreprise non assujettie (293 B) : rester à false

# Uniquement pour scripts/stripe-setup.ts, jamais lus par l'application.
STRIPE_SETUP_MODE=""                  # sandbox ou live, explicite
STRIPE_EXPECTED_ACCOUNT_ID=""         # compte Stripe attendu, vérifié avant toute écriture
STRIPE_SETUP_APP_URL=""               # origine HTTPS propre à l'environnement configuré
STRIPE_SETUP_OUTPUT_FILE=""           # nouveau fichier hors du dépôt, écrit en 0600 (contient le secret du webhook)

# ─── 7. Achats intégrés iOS et Android (RevenueCat) ─────────────────────────────
REVENUECAT_WEBHOOK_AUTH=""            # Vercel : P, V
REVENUECAT_PRODUCT_COACH=""           # [défaut tartan_coach_monthly,tartan_coach_yearly]
REVENUECAT_PRODUCT_CLUB=""            # [défaut tartan_club_monthly,tartan_club_yearly]

# ─── 8. Applications mobiles : liens, stores, notifications ─────────────────────
APPLE_TEAM_ID=""                      # liens universels iOS et webcredentials. Vercel : P
APPLE_APP_BUNDLE_IDENTIFIER=""        # coach.tartan.app. Vercel : P
ANDROID_SHA256_FINGERPRINTS=""        # empreintes Play App Signing, séparées par des virgules ; à poser au lot Android
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""   # facultatif, JSON sur une ligne ; vide : disponibilité Android confirmée à la main
EXPO_ACCESS_TOKEN=""                  # facultatif : seulement si la sécurité renforcée des notifications Expo est activée

# ─── 9. Fichiers (Vercel Blob) ───────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""              # Vercel : P, V

# ─── 10. Notifications du navigateur (Web Push) ─────────────────────────────────
# Clés : `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""       # Vercel : P, V
VAPID_PRIVATE_KEY=""                  # Vercel : P, V
VAPID_SUBJECT=""                      # [défaut mailto:bonjour@tartan.coach]. Vercel : P, V

# ─── 11. Planificateur IA (OpenAI) ──────────────────────────────────────────────
OPENAI_API_KEY=""                     # sans clé, le planificateur reste fermé. Vercel : P ; V : clé plafonnée à poser
AI_PLANNER_ENABLED=""                 # vide : actif dès qu'une clé est présente ; "false" le coupe sans redéployer
AI_PLANNER_MODEL=""                   # [défaut gpt-4.1]
AI_TRANSCRIPTION_MODEL=""             # [défaut gpt-transcribe]

# ─── 12. Tâches planifiées (cron Vercel) ─────────────────────────────────────────
CRON_SECRET=""                        # protège les routes de cron. Vercel : P, V
CRON_HEARTBEAT_URL=""                 # signal de vie vers la sonde externe ; vide : aucun appel. Vercel : P
CRON_HEARTBEAT_NOTIFICATIONS_URL=""   # même chose pour la tâche des notifications. Vercel : P

# ─── 13. Suivi des erreurs (Sentry) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""             # vide : suivi désactivé. Vercel : P
SENTRY_AUTH_TOKEN=""                  # cartes de code envoyées au build, seulement si renseigné. Vercel : P
SENTRY_ORG=""                         # Vercel : P
SENTRY_PROJECT=""                     # Vercel : P

# ─── 14. Développement et tests (jamais en production) ──────────────────────────
VIDEO_DEV_MP4_URL=""                  # vidéo locale servie à la place de Mux ; refusée en production
TEST_DATABASE_URL=""                  # [défaut postgresql://tartan@localhost:54329/tartan_test] base de Vitest
DEMO_PASSWORD=""                      # mot de passe des comptes de démonstration ; vide : tiré au hasard par la graine
