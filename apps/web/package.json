{
  "name": "@tartan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/vercel-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "COACH_SIGNUP_MODE=public tsx --env-file-if-exists=.env prisma/seed.ts",
    "demo:fill": "tsx --env-file-if-exists=.env prisma/demo-fill.ts",
    "demo:preparation": "tsx --env-file-if-exists=.env prisma/demo-preparation.ts",
    "postinstall": "prisma generate",
    "eval:planner": "node --conditions=react-server --import tsx scripts/planner-eval.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@hookform/resolvers": "7.0.1",
    "@mux/mux-node": "15.5.0",
    "@mux/upchunk": "3.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "5.105.1",
    "@tartan/api-client": "workspace:*",
    "@tartan/contracts": "workspace:*",
    "@tartan/design-tokens": "workspace:*",
    "@tartan/domain": "workspace:*",
    "@tartan/i18n": "workspace:*",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hls.js": "1.7.4",
    "jose": "6.2.13",
    "lucide-react": "1.66.0",
    "mediabunny": "1.65.2",
    "next": "16.4.3",
    "next-safe-action": "8.7.3",
    "next-zod-route": "1.0.0",
    "nuqs": "2.10.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.91.0",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "27.0.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
