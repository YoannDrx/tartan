// Modèle de données Tartan (cahier des charges, chapitre 12).
// Identifiants UUID, tables en snake_case, created_at et updated_at partout.
// Toutes les tables métier portent organization_id : base de la sécurité (§ 11.4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  passkeys    Passkey[]
  profile     Profile?
  memberships OrganizationMember[]
  ownedOrgs   Organization[]       @relation("OrgOwner")
  athletes    Athlete[]
  trainingPhases TrainingPhase[]
  devices     Device[]
  aiPlannerOperations AiPlannerOperation[]
  aiPlannerProposals AiPlannerProposal[]
  aiPlannerTranscriptions AiPlannerTranscription[]
  consents    Consent[]            @relation("ConsentUser")

  suspendedAt DateTime? @map("suspended_at")
  clientInstallations ClientInstallation[]

  // Recherche de la console d'administration (`contains` insensible à la casse).
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_email_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_name_trgm_idx")
  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  adminStepUp AdminStepUp?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  // Texte : Better Auth y écrit aussi des verrous dont l'identifiant n'est pas un UUID.
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  name         String?
  publicKey    String    @map("public_key")
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  createdAt    DateTime? @default(now()) @map("created_at")
  aaguid       String?

  @@index([userId])
  @@map("passkey")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

// ── Comptes, organisations et groupes ────────────────────────────────────────

model Profile {
  id        String    @id @db.Uuid
  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)
  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  birthDate DateTime? @map("birth_date") @db.Date
  avatarUrl String?   @map("avatar_url")
  // Accord explicite avant tout envoi au planificateur IA (OpenAI).
  aiConsentAt DateTime? @map("ai_consent_at")
  locale    String    @default("fr")
  units     String    @default("kg")
  // Envois coupables d'un clic : résumé hebdomadaire et replis de notification.
  emailDigest        Boolean @default(true) @map("email_digest")
  emailNotifications Boolean @default(true) @map("email_notifications")
  // Conseils d'activation envoyés au coach dans les jours qui suivent la création de son espace.
  emailTips          Boolean @default(true) @map("email_tips")
  // Vue du calendrier suivie d'un appareil à l'autre ; la date arbitre les écritures hors ligne.
  calendarView          String?   @map("calendar_view")
  calendarViewUpdatedAt DateTime? @map("calendar_view_updated_at")
  // Notifications par catégorie : le message reste visible dans l'app, seul l'envoi est coupé.
  pushSessions       Boolean @default(true) @map("push_sessions")
  pushFeedback       Boolean @default(true) @map("push_feedback")
  pushGroup          Boolean @default(true) @map("push_group")
  pushProductUpdates Boolean @default(true) @map("push_product_updates")
  lastSeenReleaseId  String? @map("last_seen_release_id")
  lastActiveAt       DateTime? @map("last_active_at")
  inactivityNoticeAt DateTime? @map("inactivity_notice_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

enum OrganizationType {
  club
  independent

  @@map("organization_type")
}

enum OrganizationPlan {
  pilot
  discovery
  coach
  club

  @@map("organization_plan")
}

model Organization {
  id                     String           @id @default(uuid()) @db.Uuid
  name                   String
  type                   OrganizationType @default(independent)
  logoUrl                String?          @map("logo_url")
  disciplines            String[]         @default([])
  trainingObjectives     String[]         @default([]) @map("training_objectives")
  availableEquipment     String[]         @default([]) @map("available_equipment")
  ownerId                String           @map("owner_id") @db.Uuid
  owner                  User             @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  plan                   OrganizationPlan @default(discovery)
  progressionEnabled     Boolean          @default(true) @map("progression_enabled")
  phasesEnabled          Boolean          @default(true) @map("phases_enabled")
  aiPlannerEnabled       Boolean          @default(true) @map("ai_planner_enabled")
  timeZone               String           @default("Europe/Paris") @map("time_zone")
  stripeCustomerId       String?          @unique @map("stripe_customer_id")
  // Identité du payeur : conservée au transfert, jamais assimilée au nouveau propriétaire.
  billingOwnerId         String?          @map("billing_owner_id") @db.Uuid
  billingIssue           String?          @map("billing_issue")
  lastBusinessActivityAt DateTime?        @map("last_business_activity_at")
  retentionReviewAt      DateTime?        @map("retention_review_at")
  billingRevision        Int              @default(0) @map("billing_revision")
  billingSyncedAt        DateTime?        @map("billing_synced_at")
  billingSyncAttemptedAt DateTime?        @map("billing_sync_attempted_at")
  // Relance douce d'une séance non validée, réglable par le coach (§ 7.7).
  overdueReminders       Boolean          @default(true) @map("overdue_reminders")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  trainingPhases TrainingPhase[]
  performanceCreations PerformanceCreation[]
  members           OrganizationMember[]
  groups            Group[]
  athletes          Athlete[]
  invitations       Invitation[]
  exercises         Exercise[]
  legacyStrengthMappings LegacyStrengthMapping[]
  templates         SessionTemplate[]
  scheduledSessions ScheduledSession[]
  competitions      Competition[]
  videos            Video[]
  announcements     Announcement[]
  comments          Comment[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  entitlements      Entitlement[]
  checkoutIntent    CheckoutIntent?
  aiPlannerQuotas AiPlannerQuota[]
  aiPlannerOperations AiPlannerOperation[]
  aiPlannerProposals AiPlannerProposal[]
  aiPlannerTranscriptions AiPlannerTranscription[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "organizations_name_trgm_idx")
  @@map("organizations")
}

enum MemberRole {
  owner
  coach
  assistant
  athlete
  guardian

  @@map("member_role")
}

enum MemberStatus {
  active
  invited
  suspended

  @@map("member_status")
}

model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           MemberRole
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Group {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  color          String?
  level          String?
  goal           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  trainingPhases TrainingPhase[]
  members       GroupMember[]
  coaches       GroupCoach[]
  announcements Announcement[]

  @@index([organizationId])
  @@map("groups")
}

model GroupMember {
  groupId   String   @map("group_id") @db.Uuid
  athleteId String   @map("athlete_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([groupId, athleteId])
  @@index([athleteId])
  @@map("group_members")
}

enum GroupCoachRole {
  lead
  assistant

  @@map("group_coach_role")
}

model GroupCoach {
  groupId   String         @map("group_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      GroupCoachRole @default(lead)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_coaches")
}

enum TakeoffFoot {
  left
  right

  @@map("takeoff_foot")
}

model Athlete {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  birthDate       DateTime?    @map("birth_date") @db.Date
  disciplines     String[]     @default([])
  level           String?
  takeoffFoot     TakeoffFoot? @map("takeoff_foot")
  approachSteps   Int?         @map("approach_steps")
  goals           String?
  particularities String?
  // Incrémenté pour révoquer le lien d'agenda.
  icalVersion     Int          @default(0) @map("ical_version")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  trainingPhases TrainingPhase[]
  performanceCreations PerformanceCreation[]
  athleteConsents AthleteConsent[]
  groups       GroupMember[]
  coachNotes   CoachNote[]
  injuries     Injury[]
  tests        StrengthTest[]
  strengthReferences StrengthReference[]
  prescriptions SessionPrescription[]
  performances Performance[]
  jumps        JumpAttempt[]
  wellness     WellnessCheckin[]
  guardians    Guardian[]
  overrides    AthleteOverride[]
  attendance   Attendance[]
  logs         SessionLog[]
  videos       Video[]
  consents     Consent[]
  competitions CompetitionAthlete[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("athletes")
}

// Table séparée : jamais sélectionnée pour un athlète (test dédié, § 11.4).
model CoachNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  athleteId      String   @map("athlete_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  athlete        Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@map("coach_notes")
}

enum InvitationKind {
  group_link
  qr
  personal_email
  personal_sms

  @@map("invitation_kind")
}

enum InvitationRole {
  athlete
  coach
  assistant

  @@map("invitation_role")
}

enum InvitationStatus {
  sent
  opened
  accepted
  expired
  revoked

  @@map("invitation_status")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  groupIds       String[]         @default([]) @map("group_ids") @db.Uuid
  kind           InvitationKind
  email          String?
  phone          String?
  tokenHash      String           @unique @map("token_hash")
  role           InvitationRole   @default(athlete)
  athleteId      String?          @map("athlete_id") @db.Uuid
  expiresAt      DateTime?        @map("expires_at")
  maxUses        Int?             @map("max_uses")
  useCount       Int              @default(0) @map("use_count")
  status         InvitationStatus @default(sent)
  invitedBy      String           @map("invited_by") @db.Uuid
  acceptedBy     String?          @map("accepted_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

enum ConsentStatus {
  pending
  granted
  refused

  @@map("consent_status")
}

model Guardian {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  athleteId       String        @map("athlete_id") @db.Uuid
  guardianEmail   String        @map("guardian_email")
  guardianUserId  String?       @map("guardian_user_id") @db.Uuid
  consentStatus   ConsentStatus @default(pending) @map("consent_status")
  consentAt       DateTime?     @map("consent_at")
  consentScope    Json?         @map("consent_scope")
  tokenHash       String?       @unique @map("token_hash")
  tokenExpiresAt  DateTime?     @map("token_expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  athlete         Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@map("guardians")
}

enum ConsentKind {
  terms
  health
  video

  @@map("consent_kind")
}

// Consentements explicites et séparés, révocables à tout moment (§ 15.2).
model Consent {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  athleteId      String?     @map("athlete_id") @db.Uuid
  kind           ConsentKind
  version        String
  grantedAt      DateTime?   @map("granted_at")
  revokedAt      DateTime?   @map("revoked_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  user           User        @relation("ConsentUser", fields: [userId], references: [id], onDelete: Cascade)
  athlete        Athlete?    @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  @@unique([userId, kind])
  @@map("consents")
}

// Santé et vidéo s'accordent par fiche : un sportif peut suivre un club et un préparateur sans tout mélanger.
model AthleteConsent {
  id        String      @id @default(uuid()) @db.Uuid
  athleteId String      @map("athlete_id") @db.Uuid
  kind      ConsentKind
  version   String
  grantedAt DateTime?   @map("granted_at")
  revokedAt DateTime?   @map("revoked_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")
  athlete   Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, kind])
  @@map("athlete_consents")
}

// ── Exercices et séances ─────────────────────────────────────────────────────

enum ExerciseCategory {
  strength
  plyo
  running_drill
  stairs
  cones
  mobility
  jump
  warmup

  @@map("exercise_category")
}

model Exercise {
  classification      Json?
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String?          @map("organization_id") @db.Uuid
  name                String
  category            ExerciseCategory
  tags                String[]         @default([])
  aliases             String[]         @default([])
  cues                String[]         @default([])
  defaultPrescription Json             @default("{}") @map("default_prescription")
  createdBy           String?          @map("created_by") @db.Uuid
  deletedAt           DateTime?        @map("deleted_at")
  strengthLoadKind    String?          @map("strength_load_kind")
  loadStepKg          Decimal          @default(1.25) @map("load_step_kg") @db.Decimal(6, 3)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  media ExerciseMedia[]
  videos Video[]
  items SessionItem[]
  strengthTests StrengthTest[]
  strengthReferences StrengthReference[]
  legacyStrengthMappings LegacyStrengthMapping[]

  @@index([organizationId])
  @@map("exercises")
}

enum MediaKind {
  upload
  youtube
  instagram

  @@map("media_kind")
}

// Mails liés à une transition d'abonnement : écrits dans la transaction, envoyés après, repris pendant 24 h.
model EmailOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  toEmail        String    @map("to_email")
  kind           String
  dedupeKey      String    @unique @map("dedupe_key")
  payload        Json
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  sentAt         DateTime? @map("sent_at")
  failedAt       DateTime? @map("failed_at")
  failureCode    String?   @map("failure_code")
  retryUntil     DateTime? @map("retry_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([sentAt, nextAttemptAt])
  @@map("email_outbox")
}

model CheckoutIntent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  generation     Int      @default(1)
  plan           String
  interval       String
  state          String   @default("creating")
  sessionId      String?  @map("session_id")
  url            String?
  request        Json?
  attemptedAt    DateTime? @map("attempted_at")
  expiresAt      DateTime? @map("expires_at")
  leaseToken     String?  @map("lease_token")
  leaseUntil     DateTime? @map("lease_until")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("checkout_intents")
}

// Sans FK vers l'utilisateur : une suppression ne doit pas perdre l'ordre d'annuler.
model BillingCommand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           String
  externalRef    String   @map("external_ref")
  state          String   @default("pending")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")
  leaseToken     String?  @map("lease_token")
  leaseUntil     DateTime? @map("lease_until")
  lastErrorCode  String?  @map("last_error_code")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([kind, externalRef])
  @@index([state, nextAttemptAt])
  @@map("billing_commands")
}

// File d'effacement chez les prestataires. Les triggers SQL de la migration la remplissent à chaque suppression.
model ExternalDeletion {
  id            String    @id @default(uuid()) @db.Uuid
  provider      String
  externalRef   String    @map("external_ref")
  reason        String
  notBefore     DateTime  @default(now()) @map("not_before")
  state         String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  leaseToken    String?   @map("lease_token")
  leaseUntil    DateTime? @map("lease_until")
  lastErrorCode String?   @map("last_error_code")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([provider, externalRef])
  @@index([state, nextAttemptAt])
  @@map("external_deletions")
}

model ExerciseMedia {
  id             String    @id @default(uuid()) @db.Uuid
  exerciseId     String    @map("exercise_id") @db.Uuid
  kind           MediaKind
  muxAssetId     String?   @map("mux_asset_id")
  muxUploadId    String?   @map("mux_upload_id")
  muxPlaybackId  String?   @map("mux_playback_id")
  youtubeId      String?   @map("youtube_id")
  instagramCode  String?   @map("instagram_code")
  author         String?
  // Certains auteurs interdisent la lecture hors d'Instagram : la fiche renvoie alors vers la publication.
  embeddable     Boolean   @default(true)
  customTitle    String?   @map("custom_title")
  startS         Int?      @map("start_s")
  endS           Int?      @map("end_s")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  exercise       Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@map("exercise_media")
}

enum SessionType {
  strength
  plyo
  running
  stairs
  cones
  mobility
  jump

  @@map("session_type")
}

enum BlockVariant {
  club
  autonomous
  both

  @@map("block_variant")
}

model SessionTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  type           SessionType
  durationMin    Int?         @map("duration_min")
  coachNote      String?      @map("coach_note")
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  blocks SessionBlock[]

  @@index([organizationId])
  @@map("session_templates")
}

model SessionBlock {
  id         String          @id @default(uuid()) @db.Uuid
  templateId String          @map("template_id") @db.Uuid
  name       String
  position   Int
  variant    BlockVariant    @default(both)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  template   SessionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  items SessionItem[]

  @@index([templateId])
