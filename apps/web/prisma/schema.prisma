  lastSeenAt     DateTime @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([platform, appVersionCode])
  @@index([lastSeenAt])
  @@map("client_installations")
}

// État de diffusion d'une version. Les notes restent dans packages/i18n/src/releases.ts.
model AppReleaseTarget {
  id             String    @id @default(uuid()) @db.Uuid
  releaseId      String    @map("release_id")
  platform       String
  version        String
  versionCode    Int?      @map("version_code")
  delivery       String
  state          String
  storeCheckedAt DateTime? @map("store_checked_at")
  availableAt    DateTime? @map("available_at")
  rolloutCursor  String?   @map("rollout_cursor") @db.Uuid
  notifiedCount  Int       @default(0) @map("notified_count")
  lastErrorCode  String?   @map("last_error_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([releaseId, platform])
  @@index([delivery, state])
  @@map("app_release_targets")
}

// Réglages de la plateforme, modifiables depuis la console sans redéploiement.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Administrateurs ajoutés depuis la console ; ADMIN_EMAILS reste la racine non révocable.
model PlatformAdmin {
  email       String    @id
  addedById   String?   @map("added_by_id") @db.Uuid
  // Fenêtre d'enrôlement de la première passkey, sans jeton.
  enrollUntil DateTime? @map("enroll_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("platform_admins")
}

model AppPlatformConfig {
  platform           String   @id
  minimumVersion     String?  @map("minimum_version")
  minimumVersionCode Int?     @map("minimum_version_code")
  reason             String?
  updatedBy          String?  @map("updated_by") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("app_platform_configs")
}

// Journal des accès aux données sensibles et des suppressions. Jamais de donnée de santé en clair.
model EmailSuppression {
  emailHash String @id @map("email_hash")
  reason String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_suppressions")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?       @map("entity_id")
  // Valeurs fermées (montant, motif, offre) : aucun texte libre, aucune donnée de santé.
  metadata       Json?
  at             DateTime      @default(now())
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, at])
  @@index([at])
  @@index([actorId, at])
  @@index([action(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_log_action_trgm_idx")
  @@map("audit_log")
}

// Signalement de contenu et blocage d'utilisateur (exigences App Store, § 16.2).
model ContentReport {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  reason         String
  detail         String?
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("content_reports")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

// ── Abonnements et parrainage ────────────────────────────────────────────────

model Plan {
  key       String   @id
  name      String
  limits    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled

  @@map("subscription_status")
}

enum SubscriptionProvider {
  stripe
  revenuecat
  manual

  @@map("subscription_provider")
}

model Subscription {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  planKey          String               @map("plan_key")
  status           SubscriptionStatus   @default(active)
  provider         SubscriptionProvider @default(manual)
  providerRef      String?              @map("provider_ref")
  paidSince        DateTime?            @map("paid_since")
  currentPeriodEnd DateTime?            @map("current_period_end")
  cancelAt         DateTime?            @map("cancel_at")
  // Revenu mensuel hors taxes, recalculé à chaque rapprochement avec Stripe.
  interval           String?   @map("billing_interval")
  listMrrCents       Int?      @map("list_mrr_cents")
  discountedMrrCents Int?      @map("discounted_mrr_cents")
  discountEndsAt     DateTime? @map("discount_ends_at")
  trialEndsAt        DateTime? @map("trial_ends_at")
  canceledAt         DateTime? @map("canceled_at")
  startedAt          DateTime? @map("started_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("subscriptions")
}

enum EntitlementSource {
  plan
  stripe
  revenuecat
  admin
  referral

  @@map("entitlement_source")
}

model Entitlement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  key            String
  value          Json
  source         EntitlementSource @default(plan)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("entitlements")
}

enum ReferralOwnerType {
  user
  organization

  @@map("referral_owner_type")
}

model ReferralCode {
  id        String            @id @default(uuid()) @db.Uuid
  ownerType ReferralOwnerType @map("owner_type")
  ownerId   String            @map("owner_id") @db.Uuid
  code      String            @unique
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  referrals Referral[]

  @@unique([ownerType, ownerId])
  @@map("referral_codes")
}

enum ReferralStatus {
  signed_up
  trialing
  qualified
  rewarded
  rejected

  @@map("referral_status")
}

model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  codeId         String         @map("code_id") @db.Uuid
  referredUserId String         @unique @map("referred_user_id") @db.Uuid
  referredOrgId  String?        @map("referred_org_id") @db.Uuid
  status         ReferralStatus @default(signed_up)
  qualifiedAt    DateTime?      @map("qualified_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  code           ReferralCode   @relation(fields: [codeId], references: [id], onDelete: Cascade)

  rewards ReferralReward[]

  @@index([codeId])
  @@map("referrals")
}

// Événements déjà traités : Stripe et RevenueCat peuvent renvoyer plusieurs fois le même.
model BillingEvent {
  id        String   @id
  provider  String
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("billing_events")
}

enum RewardKind {
  free_month
  discount

  @@map("reward_kind")
}

model ReferralReward {
  id            String     @id @default(uuid()) @db.Uuid
  referralId    String     @map("referral_id") @db.Uuid
  beneficiaryId String     @map("beneficiary_id") @db.Uuid
  kind          RewardKind
  value         Json       @default("{}")
  appliedAt     DateTime?  @map("applied_at")
  providerRef   String?    @map("provider_ref")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  referral      Referral   @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_rewards")
}

// « Recommanderais-tu Tartan ? » (§ 18) : une réponse par personne et par mois, sans donnée de santé.
model SatisfactionAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  recommend      Boolean
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("satisfaction_answers")
}

model TrainingPhase {
  id String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  groupId String? @map("group_id") @db.Uuid
  athleteId String? @map("athlete_id") @db.Uuid
  createdBy String? @map("created_by") @db.Uuid
  name String
  kind String
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  objective String @default("")
  description String @default("")
  privateNote String @default("") @map("private_note")
  publishedAt DateTime? @map("published_at")
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  creationFingerprint String @map("creation_fingerprint")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  @@index([organizationId, startDate, endDate])
  @@index([groupId])
  @@index([athleteId])
  @@map("training_phases")
}

// Compteurs agrégés sans texte ni identité personnelle. Une réservation et son
// opération sont écrites sous le même verrou d’espace, hors appel fournisseur.
model AiPlannerQuota {
  organizationId String @map("organization_id") @db.Uuid
  month String @db.VarChar(7)
  reservedProposals Int @default(0) @map("reserved_proposals")
  usedProposals Int @default(0) @map("used_proposals")
  reservedAudioSeconds Int @default(0) @map("reserved_audio_seconds")
  usedAudioSeconds Int @default(0) @map("used_audio_seconds")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([organizationId, month])
  @@map("ai_planner_quotas")
}

model AiPlannerOperation {
  organizationId String @map("organization_id") @db.Uuid
  id String @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  kind String
  fingerprint String
  proposalId String? @map("proposal_id") @db.Uuid
  month String @db.VarChar(7)
  proposalCost Int @map("proposal_cost")
  audioSeconds Int @map("audio_seconds")
  state String @default("pending")
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime @map("lease_until")
  // Référence de résultat seulement, jamais de transcription ni texte du coach.
  result Json?
  failureCode String? @map("failure_code")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@id([organizationId, id])
  @@index([state, leaseUntil])
  @@index([expiresAt])
  @@index([actorId])
  @@map("ai_planner_operations")
}

// Contenu privé de travail, purgé au plus tard après sept jours ou sous 24 h
// après conversion. Le registre de quota ne conserve que sa référence.
model AiPlannerProposal {
  id String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  creationFingerprint String @map("creation_fingerprint")
  state String @default("processing")
  version Int @default(1)
  clarificationCount Int @default(0) @map("clarification_count")
  selection Json
  bindings Json
  messages Json
  interpretation Json?
  activeOperationId String @map("active_operation_id") @db.Uuid
  pendingMessage String? @map("pending_message")
  committedAt DateTime? @map("committed_at")
  commitFingerprint String? @map("commit_fingerprint")
  draftIds Json? @map("draft_ids")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([organizationId, actorId, createdAt])
  @@index([expiresAt])
  @@map("ai_planner_proposals")
}

// Texte brut à relire, jamais l’audio. Conservation courte de 24 heures au plus,
// indépendante des propositions relues qui ont leur propre échéance.
model AiPlannerTranscription {
  id String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  state String @default("processing")
  version Int @default(1)
  text String?
  audioSeconds Int @map("audio_seconds")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([organizationId, actorId])
  @@index([expiresAt])
  @@map("ai_planner_transcriptions")
}

// Miroir local des factures : listes et agrégats. Tout geste sur l'argent relit Stripe.
model BillingInvoice {
  id                   String    @id
  livemode             Boolean
  // Sans clé étrangère : une facture se conserve après la suppression de l'espace.
  organizationId       String?   @map("organization_id") @db.Uuid
  stripeCustomerId     String    @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  paymentIntentId      String?   @map("payment_intent_id")
  chargeId             String?   @map("charge_id")
  number               String?
  status               String
  currency             String
  totalCents           Int       @map("total_cents")
  amountPaidCents      Int       @map("amount_paid_cents")
  taxCents             Int       @default(0) @map("tax_cents")
  discountCents        Int       @default(0) @map("discount_cents")
  refundedCents        Int       @default(0) @map("refunded_cents")
  periodStart          DateTime? @map("period_start")
  periodEnd            DateTime? @map("period_end")
  paidAt               DateTime? @map("paid_at")
  stripeCreatedAt      DateTime  @map("stripe_created_at")
  syncedAt             DateTime  @map("synced_at")

  @@index([stripeCreatedAt])
  @@index([organizationId])
  @@index([chargeId])
  @@index([paidAt])
  @@map("billing_invoices")
}

model BillingDispute {
  id             String    @id
  livemode       Boolean
  chargeId       String    @map("charge_id")
  organizationId String?   @map("organization_id") @db.Uuid
  amountCents    Int       @map("amount_cents")
  status         String
  reason         String
  dueBy          DateTime? @map("due_by")
  syncedAt       DateTime  @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("billing_disputes")
}

// Commande de remboursement : requête exacte conservée, reprise possible avec la même clé.
model BillingRefund {
  id                    String    @id @default(uuid()) @db.Uuid
  invoiceId             String    @map("invoice_id")
  organizationId        String?   @map("organization_id") @db.Uuid
  livemode              Boolean
  amountCents           Int       @map("amount_cents")
  reasonCode            String    @map("reason_code")
  // Lue dans la console seulement : jamais envoyée à Stripe ni écrite au journal.
  note                  String?
  withdrawal            Boolean   @default(false)
  source                String
  state                 String
  confirmationHash      String?   @map("confirmation_hash")
  confirmationExpiresAt DateTime? @map("confirmation_expires_at")
  expectedRefundedCents Int       @map("expected_refunded_cents")
  inFlightInvoiceId     String?   @unique @map("in_flight_invoice_id")
  request               Json?
  attemptedAt           DateTime? @map("attempted_at")
  attempts              Int       @default(0)
  leaseToken            String?   @map("lease_token")
  leaseUntil            DateTime? @map("lease_until")
  lastErrorCode         String?   @map("last_error_code")
  stripeRefundId        String?   @unique @map("stripe_refund_id")
  stripeCreditNoteId    String?   @unique @map("stripe_credit_note_id")
  preparedBy            String    @map("prepared_by") @db.Uuid
  confirmedAt           DateTime? @map("confirmed_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([state, attemptedAt])
  @@index([invoiceId])
  @@map("billing_refunds")
}

model AdminStepUp {
  sessionId  String   @id @map("session_id") @db.Uuid
  method     String
  verifiedAt DateTime @map("verified_at")
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("admin_step_ups")
}

model PlatformDailyStat {
  day           DateTime @id @db.Date
  mrrCents      Int      @map("mrr_cents")
  payingOrgs    Int      @map("paying_orgs")
  trialing      Int
  pastDue       Int      @map("past_due")
  canceled      Int
  newPaid       Int      @map("new_paid")
  users         Int
  activeUsers7d Int      @map("active_users_7d")
  refundedCents Int      @map("refunded_cents")

  @@map("platform_daily_stats")
}
