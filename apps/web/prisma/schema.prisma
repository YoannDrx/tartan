model Video {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  athleteId          String            @map("athlete_id") @db.Uuid
  uploadedBy         String            @map("uploaded_by") @db.Uuid
  scheduledSessionId String?           @map("scheduled_session_id") @db.Uuid
  // Mouvement travaillé, facultatif : un exercice retiré ne supprime pas la vidéo.
  exerciseId         String?           @map("exercise_id") @db.Uuid
  muxUploadId        String?           @map("mux_upload_id")
  muxAssetId         String?           @map("mux_asset_id")
  muxPlaybackId      String?           @map("mux_playback_id")
  // Écrit seulement quand le préavis de purge a été accepté par Resend.
  purgeNoticeAt      DateTime?         @map("purge_notice_at")
